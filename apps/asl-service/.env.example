# ASL Service — stub by default; set ASL_USE_STUB=0 when WLASL model is integrated
ASL_USE_STUB=1

# Path to WLASL I3D checkpoint (.pt) when not using stub mode.
# Example: ASL_MODEL_PATH=/app/models/FINAL_nslt_2000.pt
# ASL_MODEL_PATH=

# Optional: path to wlasl_class_list.txt. If omitted, the service will look for
# WLASL checked out at repo_root/WLASL/code/I3D/preprocess/wlasl_class_list.txt
# ASL_CLASS_LIST_PATH=

# Optional: WLASL I3D code directory (override when container layout differs).
# WLASL_I3D_DIR=/app/WLASL/code/I3D

# Optional: device for PyTorch ('cpu' or 'cuda'); default is cpu.
# ASL_DEVICE=cpu
#
# Optional: min confidence (0–1) to return a product gloss; below this we return a "try again" message (default 0.30).
# Live recordings often peak around 0.2–0.4; use ~0.25–0.35 unless you fine-tune on your camera.
# ASL_CONFIDENCE_THRESHOLD=0.30
#
# Optional: min gap between top-1 and top-2 softmax prob (default 0.04).
# ASL_MIN_TOP_MARGIN=0.04
#
# Optional: full-clip vs center-window second pass — "best" (default) or "blend" (averages softmax, lowers peaks).
# ASL_DUAL_PASS_MODE=best
#
# Optional: multiply probabilities for shopping-related glosses.
# Helps reduce mismatches like product signs mapping to emotion/action glosses.
# ASL_SHOPPING_BIAS_BOOST=1.35
#
# Optional: MediaPipe template recognizer (recommended for live recordings).
# Set to 1 to enable /predict MediaPipe-first routing and /mediapipe/enroll endpoint.
# ASL_MEDIAPIPE_ENABLED=1
# In Docker, keep this path so templates persist via docker-compose volume:
# ASL_MEDIAPIPE_TEMPLATES_DIR=/app/mediapipe_templates
# Softmax only over the K *nearest* DTW templates so probability is not diluted across all labels (default 8).
# ASL_MEDIAPIPE_SOFTMAX_TOP_K=8
# Accept best template when 2nd-best DTW is at least this fraction worse than the best: (d2-d1)/d1 (default 0.10).
# ASL_MEDIAPIPE_REL_MARGIN_ACCEPT=0.10
# After softmax_top_k fix, 0.35–0.45 is typical; raise if you get wrong-label accepts.
# ASL_MEDIAPIPE_CONFIDENCE_THRESHOLD=0.40
# ASL_MEDIAPIPE_MIN_DET_CONF=0.5
# ASL_MEDIAPIPE_MIN_TRACK_CONF=0.5
#
# Optional: how many alternatives appear in /predict JSON (default 8, max 100).
# Restart the ASL service after changing this (env is read at startup).
# ASL_ALTERNATIVES_K=50
#
# Optional: I3D time pooling — mean (default) or max (try if your signs match WLASL test scripts better).
# ASL_LOGIT_AGG=mean
#
# Optional live-video quality gates (recommended for webcam recordings).
# Reject clips that are too short, too still, too dark, or too blurry.
# ASL_MIN_REQUIRED_FRAMES=12
# ASL_MIN_MOTION_MEAN=0.018
# ASL_MIN_BRIGHTNESS=18.0
# ASL_MIN_BLUR_LAPLACIAN=8.0

PORT=8004
LOG_LEVEL=INFO
