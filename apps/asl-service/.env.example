# ASL Service — stub by default; set ASL_USE_STUB=0 when WLASL model is integrated
ASL_USE_STUB=1

# Path to WLASL I3D checkpoint (.pt) when not using stub mode.
# Example: ASL_MODEL_PATH=/app/models/FINAL_nslt_2000.pt
# ASL_MODEL_PATH=

# Optional: path to wlasl_class_list.txt. If omitted, the service will look for
# WLASL checked out at repo_root/WLASL/code/I3D/preprocess/wlasl_class_list.txt
# ASL_CLASS_LIST_PATH=

# Optional: WLASL I3D code directory (override when container layout differs).
# WLASL_I3D_DIR=/app/WLASL/code/I3D

# Optional: device for PyTorch ('cpu' or 'cuda'); default is cpu.
# ASL_DEVICE=cpu
#
# Optional: min confidence (0–1) to return a product gloss; below this we return a "try again" message (default 0.35).
# ASL_CONFIDENCE_THRESHOLD=0.35
#
# Optional: min gap between top-1 and top-2 softmax prob (default 0.06). Stops "clothes vs book" coin flips.
# ASL_MIN_TOP_MARGIN=0.06
#
# Optional: how many alternatives appear in /predict JSON (default 8, max 100).
# Restart the ASL service after changing this (env is read at startup).
# ASL_ALTERNATIVES_K=50
#
# Optional: I3D time pooling — mean (default) or max (try if your signs match WLASL test scripts better).
# ASL_LOGIT_AGG=mean

PORT=8004
LOG_LEVEL=INFO
