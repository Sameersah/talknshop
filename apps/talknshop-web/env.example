# WebSocket URL for orchestrator service
VITE_WS_URL=ws://localhost:8000/ws/chat
# Orchestrator HTTP API (for presigned upload URL: POST /api/v1/media/upload-url)
VITE_ORCHESTRATOR_API_URL=http://localhost:8000

# API Base URL (fallback if VITE_ORCHESTRATOR_API_URL not set)
VITE_API_URL=http://localhost:8000

# Default User ID for testing
VITE_USER_ID=test_user_web

# Environment
VITE_ENV=development






